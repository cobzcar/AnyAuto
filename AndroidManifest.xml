<?xml version="1.0" encoding="utf-8"?>
<!-- AnyAuto: shows ordinary phone apps on the Android Auto screen. Shizuku (shell rights) makes a
     virtual display the size of the car screen, starts the chosen app on it and injects the car's
     taps and drags; the display draws straight into the NavigationTemplate surface. See README.md.
     Source manifest: build.sh merges it with the library manifests (Google's manifest merger) and
     injects minSdk, targetSdk, versionCode and versionName, so do not add <uses-sdk> here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mag.anyauto">

    <!-- NavigationTemplate (navigation apps only) and its drawing surface -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- bind DisplayService as the shell user through Shizuku -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <!-- the apps that can be put in the car: everything with a launcher icon -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- the widgets that can be put in the car (Poweramp's, see Widgets.java) -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- "Open UnknownAuto" when it is installed (install-for-the-car guidance) -->
        <package android:name="com.mag.unknownauto" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Android Auto: this app uses the car templates -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- 5: SurfaceCallback.onClick (taps on the surface); scroll, fling and scale are level 2 -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="5" />

        <!-- NAVIGATION category: the only one that gets a raw surface for the whole car screen
             (and the dashboard's map card). AnyAuto never starts navigation, so a Google Maps
             route keeps the navigation focus. No NAVIGATE intent filter on purpose. -->
        <service
            android:name=".car.AnyAutoService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Choose apps (search at the top, Done at the bottom above the keyboard) and Help -->
        <activity
            android:name=".PickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".HelpActivity"
            android:exported="false" />

        <!-- the Poweramp widget for the car: chosen and allowed on the phone (WidgetSetupActivity),
             shown on the car display (WidgetActivity). Exported because the shell user starts
             it on the virtual display, as it starts any other app. -->
        <activity
            android:name=".WidgetSetupActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity
            android:name=".WidgetActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- the car screen simulated on the phone: same display, launch and gesture path as the car -->
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <!-- the preview from a computer: am start of .Try with the app as ComponentName extra
             "app" (README, Testing). DUMP is held by the adb shell but cannot be granted to
             ordinary apps -->
        <activity-alias
            android:name=".Try"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:targetActivity=".PreviewActivity" />

        <!-- the headless car for tests (Headless.java, README Testing); DUMP = adb shell only -->
        <receiver
            android:name=".Headless"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Shizuku client: receives the Shizuku binder so the user service can be bound -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.mag.anyauto.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
    </application>
</manifest>
